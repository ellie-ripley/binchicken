<div .container>
   <div .row>
       <h3>Summary

<div .container>
    <div .row>
        <form method=post action=@{SeshatR} enctype=#{enctype}>
            ^{gFormWidget}
            <button>Submit
    <div .row>
        <div .col-lg-12>
            <table>
                <thead>
                    <tr>
                        <th>ID
                        <th>Email
                        <th>Total
                        $forall et <- exts
                            <th>#{show (fromEnum et)}
                        <th>Year
                        <th>Section
                        <th>Set Year/Section?
                <tbody>
                $forall (Entity i u) <- usrs
                    $with myms <- grYearSection groups i
                      <tr>
                        <td>#{displayUserId i}
                        <td>#{userEmail u}
                        $maybe src <- M.lookup i (unSummary summ)
                            <td>#{displayPoints (totalPoints src)}
                            $forall et <- exts
                                <td>#{displayScore (exScore src et)}
                        $nothing
                            <td>Error 23
                        <td>#{displayYear $ fst myms}
                        <td>#{displaySection $ snd myms}
                        <td><input id=#{updateTag <> displayUserId i} type="checkbox">
