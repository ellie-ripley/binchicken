<div .container>
   <div .row>
       <h3>Summary

<div .container>
    <div .row>
        <div .col-lg-2>
                <select class="form-select" name="year" id=#{yearInputId}>
                    <option value="*">Choose a year
                    $forall ty <- yearList
                        <option value=#{show $ snd ty}>#{fst ty}
        <div .col-lg-2>
                <div class="input-group mb-3">
                    <span class="input-group-text">Section:
                    <input type="text" class="form-control" id=#{sectionInputId}>
        <div .col-lg-2>
            <button type="button" class="btn btn-primary" id=#{submitButtonId}>Update all checked users
    <div .row>
        <div .col-lg-12>
            <p id=#{updateMsgId}>
    <div .row>
        <div .col-lg-12>
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID
                        <th>Email
                        <th>Total
                        $forall et <- exts
                            <th>#{show (fromEnum et)}
                        <th>Year
                        <th>Section
                        <th>Set Year/Section?
                <tbody>
                $forall (Entity i u) <- usrs
                    $with myms <- grYearSection groups i
                      <tr>
                        <td>#{displayUserId i}
                        <td>#{userEmail u}
                        $maybe src <- M.lookup i (unSummary summ)
                            <td>#{displayPoints (totalPoints src)}
                            $forall et <- exts
                                <td>#{displayScore (exScore src et)}
                        $nothing
                            <td>Error 23
                        <td>#{displayYear $ fst myms}
                        <td>#{displaySection $ snd myms}
                        <td><input name=#{updateCheck} id=#{updateTag <> displayUserId i} type="checkbox">
    <div .row>
        <div .col-lg-12>
            <form method=post action=@{SeshatCSVR} enctype=#{enctype} id=#{csv}>
                ^{csvWidget}
                <button type="submit" form=#{csv} class="btn btn-primary">Gimme a CSV!
