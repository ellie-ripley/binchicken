<div .container>
    ^{loginNotifyW}
    <div .row>
        <h2>Murder mystery, group #{groupNum}
    <div .row>
        <h4>YOUR GROUP WILL LOSE POINTS for each incorrect entry.
        <p>When you are ready, enter your conclusion below:
    <div .row>
        <div .col-lg-12>
            <form method=post action=@{MurderR} enctype=#{enctype}>
                ^{widg}
                <button .btn.btn-primary>Submit
    <div .row>
        <div .col-lg-12>
            <p>Past guesses (correct parts have a green background):
            ^{history}
